# prack configuration. Copy to .env and change what you need; every variable is optional.
# Variables set in the environment win over this file.

# --- web server -------------------------------------------------------------------------
# PRACK_HOST=127.0.0.1          # 0.0.0.0 to listen on all interfaces
# PRACK_PORT=8000
# PRACK_AUTH_USER=pilot         # optional HTTP basic auth; set both or neither
# PRACK_AUTH_PASSWORD=choose-a-long-password

# --- storage ----------------------------------------------------------------------------
# PRACK_DATA_DIR=data           # SQLite file and caches
# PRACK_DATABASE_URL=           # empty: SQLite in PRACK_DATA_DIR. PostgreSQL: postgresql+psycopg://user:pw@host/prack
# PRACK_LOG_LEVEL=INFO

# --- regions ----------------------------------------------------------------------------
# PRACK_REGIONS=ch              # comma separated ids of region files
# PRACK_REGIONS_DIR=            # folder with your own region files (see prack/regions/ch.toml)

# --- OGN feed ---------------------------------------------------------------------------
# PRACK_OGN_HOST=aprs.glidernet.org
# PRACK_OGN_PORT=14580
# PRACK_OGN_CALLSIGN=           # read-only login, at most 9 characters; empty: PRACK + 4 random digits
# PRACK_OGN_FILTER_MARGIN_KM=30 # listen this far beyond the region box so border crossings are not cut

# --- what is tracked --------------------------------------------------------------------
# PRACK_TRACKED_TYPES=7         # OGN aircraft types: 7 paraglider, 6 hang glider, 1 glider, ...
# PRACK_RESPECT_STEALTH=true    # drop devices that set the stealth flag
# PRACK_MIN_FIX_INTERVAL=1      # seconds between stored fixes per aircraft

# --- terrain ----------------------------------------------------------------------------
# PRACK_TERRAIN_ENABLED=true    # height of the ground under every fix (AGL), cached in PRACK_DATA_DIR/dem
# PRACK_TERRAIN_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
# PRACK_TERRAIN_ZOOM=12         # about 30 m per pixel in the Alps

# --- OGN device database ----------------------------------------------------------------
# PRACK_DDB_ENABLED=true        # registrations, competition numbers and owners' opt-outs
# PRACK_DDB_URL=https://ddb.glidernet.org/download/?j=1&t=1

# --- Docker Compose only (docker-compose.yml) -------------------------------------------
# PRACK_PUBLISH_PORT=8000       # the port on this machine (127.0.0.1) that the container is published on
# PRACK_DOMAIN=tracker.example.org  # for `docker compose --profile https up -d`: the name Caddy gets a certificate for
